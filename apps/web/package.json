{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p ${PORT:-3000}",
    "dev:turbo": "next dev --turbopack -p ${PORT:-3000}",
    "dev:webpack": "next dev --webpack -p ${PORT:-3000}",
    "dev:stable": "next dev --webpack -p ${PORT:-3000}",
    "dev:emu": "NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true next dev --turbopack -p ${PORT:-3000}",
    "dev:emu:stable": "NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true next dev --webpack -p ${PORT:-3000}",
    "build": "node scripts/safe-next-build.mjs",
    "build:turbo": "node scripts/safe-next-build.mjs --turbopack",
    "start": "next start",
    "test:runtime:public-season-route": "node tests/runtime/public-season-route-runtime.mjs --mode=dev",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "typecheck:fandom": "tsc -p tsconfig.typecheck.fandom.json --noEmit",
    "validate:quick": "pnpm run generated:check && pnpm exec vitest run -c vitest.config.mts tests/proxy-routing.test.ts tests/public-identity-contract.test.ts tests/public-route-boundary.test.ts",
    "lint": "NODE_OPTIONS=--max-old-space-size=8192 eslint",
    "clean": "rm -rf .next .next-e2e .next-e2e-debug .next-e2e-public test-results *.tsbuildinfo",
    "generated:check": "node scripts/generate-admin-api-references.mjs --check && node scripts/generate-brand-font-artifacts.mjs --check && node scripts/generate-trr-v2-api-types.mjs --check && node scripts/generate-nyt-homepage-preview-fragments.mjs --check && node scripts/generate-reddit-capture-contract.mjs --check",
    "generate:nyt-homepage-preview-fragments": "node scripts/generate-nyt-homepage-preview-fragments.mjs",
    "generate:trr-v2-api-types": "node scripts/generate-trr-v2-api-types.mjs",
    "generated:trr-v2-api-types:check": "node scripts/generate-trr-v2-api-types.mjs --check",
    "generate:brand-font-artifacts": "node scripts/generate-brand-font-artifacts.mjs",
    "generate:brand-font-artifacts:with-glyphs": "node scripts/generate-brand-font-artifacts.mjs --with-glyph-comparison",
    "brand-fonts:visual-similarity": "node scripts/brand-font-visual-similarity.mjs",
    "brand-fonts:glyph-comparison": "node scripts/brand-font-glyph-comparison.mjs",
    "perf:admin:api": "node scripts/perf-admin-api.mjs",
    "design-docs:classify": "node scripts/design-docs/classify-publisher-patterns.mjs",
    "design-docs:extract-navigation": "node scripts/design-docs/extract-navigation.mjs",
    "design-docs:nyt-games:media": "node scripts/design-docs/generate-nyt-games-media-artifacts.mjs",
    "design-docs:nyt-games:media:validate": "node scripts/design-docs/validate-nyt-games-media.mjs",
    "design-docs:validate-config": "node scripts/design-docs/validate-config-integrity.mjs",
    "design-docs:a11y-audit": "node scripts/design-docs/run-accessibility-audit.mjs",
    "design-docs:integration-checks": "node scripts/design-docs/run-integration-checks.mjs",
    "test": "vitest run -c vitest.config.mts",
    "test:watch": "vitest -c vitest.config.mts",
    "test:ci": "node scripts/test-ci.mjs",
    "smoke:admin-detail-routes": "node scripts/browser-smoke-admin-detail-routes.mjs",
    "smoke:cast:preflight": "node scripts/cast-smoke-preflight.mjs",
    "smoke:cast:preflight:auth": "node scripts/cast-smoke-preflight.mjs --cookie-file \"${TRR_CAST_SMOKE_COOKIE_FILE:-}\"",
    "test:e2e": "playwright test -c playwright.config.ts",
    "test:e2e:cast": "playwright test -c playwright.config.ts tests/e2e/admin-cast-tabs-smoke.spec.ts",
    "test:e2e:cast:live": "E2E_CAST_LIVE=1 playwright test -c playwright.config.ts tests/e2e/admin-cast-tabs-live-smoke.spec.ts",
    "test:e2e:headed": "playwright test -c playwright.config.ts --headed",
    "db:migrate": "node ./scripts/run-migrations.mjs",
    "generate:reddit-capture-contract": "node scripts/generate-reddit-capture-contract.mjs --export",
    "generated:reddit-capture-contract:check": "node scripts/generate-reddit-capture-contract.mjs --check",
    "generated:reddit-capture-contract:source-check": "node scripts/generate-reddit-capture-contract.mjs --check-source"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@firebase/app": "0.16.5",
    "@firebase/component": "0.7.5",
    "@firebase/firestore": "4.19.1",
    "@firebase/logger": "0.5.2",
    "@firebase/util": "1.15.3",
    "@sentry/nextjs": "^10.78.0",
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-query": "^5.107.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.11.0",
    "@vercel/speed-insights": "^2.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^13.2.0",
    "firebase-admin": "^14.5.0",
    "framer-motion": "^14.10.1",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "openapi-fetch": "^0.17.0",
    "openapi-react-query": "^0.5.4",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "^4.23.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "undici": "^8.12.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@trr/api-types-tool": "workspace:*",
    "@types/node": "^25.9.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "ajv": "^8.20.0",
    "dotenv": "^18.0.9",
    "esbuild": "0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.5",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.5",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "vitest-axe": "^0.1.0",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": "24.x"
  }
}
